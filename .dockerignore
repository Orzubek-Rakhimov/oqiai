# Only what the app needs goes into the images.

.git
.github
.idea
.vscode
.claude
.agents
.ai
.scratch
graphify-out

# Secrets and local settings never go into an image.
.env
.env.*
!.env.example
!.env.production.example
auth.json
**/*.pem
**/*.key
storage/app/private/*
!storage/app/private/.gitignore
storage/app/public/*
!storage/app/public/.gitignore
storage/database

# Installed and built fresh inside the image.
vendor
node_modules
public/build
public/hot
public/storage
public/fonts-manifest.dev.json
bootstrap/ssr
resources/js/actions
resources/js/routes
resources/js/wayfinder

# Everything that isn't the app itself.
tests
docs
compose.production.yaml
phpunit.xml
phpstan.neon
pint.json
boost.json
skills-lock.json
.mcp.json
CLAUDE.md
AGENTS.md
GLOSSARY.md
README.md

# Local runtime files.
database/*.sqlite
storage/logs/*
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/views/*
storage/framework/testing/*
storage/pail
.phpunit.cache
.phpunit.result.cache
*.log
bootstrap/cache/*.php
